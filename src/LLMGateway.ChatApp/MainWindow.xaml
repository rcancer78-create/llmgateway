<Window x:Class="LLMGateway.ChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LLMGateway.ChatApp"
        Title="LLMGateway — тестовый чат"
        Width="1320" Height="860" MinWidth="960" MinHeight="620"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <DockPanel>
        <!-- Top App Bar / Connection & Server Bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <!-- Row 1: Brand, Mode Switcher, Gateway connection & Server controls -->
                <WrapPanel VerticalAlignment="Center">
                    <!-- Brand / App Logo -->
                    <Border Background="{StaticResource PrimaryMutedBrush}" CornerRadius="8" Padding="7,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSparkles}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="LLMGateway" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Mode Selector Segmented Group -->
                    <Border Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Библиотека (прямой)" IsChecked="{Binding IsLibraryMode}"
                                         Style="{StaticResource SegmentedRadioButton}" ToolTip="Прямой вызов NativeGateway" />
                            <RadioButton Content="OpenAI API (HTTP)" IsChecked="{Binding IsApiMode}"
                                         Style="{StaticResource SegmentedRadioButton}" ToolTip="Подключение по протоколу OpenAI API" />
                        </StackPanel>
                    </Border>

                    <!-- API URL & Key (Enabled in API mode) -->
                    <TextBlock Text="URL:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0"
                             VerticalAlignment="Center" ToolTip="Адрес API (без /v1)" IsEnabled="{Binding IsApiMode}" />

                    <TextBlock Text="Ключ:" Style="{StaticResource FieldLabel}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,10,0"
                             VerticalAlignment="Center" IsEnabled="{Binding IsApiMode}"
                             ToolTip="Bearer-ключ шлюза (LLMGateway:Server:ApiKey) обязателен для /v1, включая loopback. Пустой ключ не разрешает доступ; встроенный сервер создаёт ключ автоматически." />

                    <!-- Primary Connection Buttons -->
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGlobe}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Подключить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Обновить всё" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Vertical Divider -->
                    <Rectangle Width="1" Height="22" Fill="{StaticResource CardBorderBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <!-- Embedded Server Controls -->
                    <TextBlock Text="Встроенный сервер:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding EmbeddedUrl, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <Button Style="{StaticResource SuccessButton}" Command="{Binding StartServerCommand}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="{StaticResource SuccessBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Запустить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding StopServerCommand}" Margin="0,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPower}" Fill="{StaticResource DangerBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Остановить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Row 2: Status chips for Connection & Server -->
                <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionState}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerState}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Modern Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Navigation TabControl -->
        <TabControl Background="{StaticResource AppBackgroundBrush}">
            <!-- TAB 1: ЧАТ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconChat}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Чат" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Chat Message Stream -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="14">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ChatMessageViewModel}">
                                        <Border x:Name="Bubble" CornerRadius="10" Padding="14,10" Margin="0,5"
                                                BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                                Background="{StaticResource CardBackgroundBrush}">
                                            <StackPanel>
                                                <!-- Header with Avatar / Role Icon -->
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="RoleBadge" CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                                                                Padding="5,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Path x:Name="RoleIcon" Data="{StaticResource IconSparkles}"
                                                                  Fill="{StaticResource PrimaryBrush}" Width="12" Height="12"
                                                                  Stretch="Uniform" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Reasoning / Thinking collapsible card -->
                                                <Expander Header="Рассуждения модели"
                                                          Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVisibility}}"
                                                          Margin="0,4,0,6">
                                                    <TextBox Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True"
                                                             TextWrapping="Wrap" BorderThickness="0"
                                                             Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                                             FontFamily="Cascadia Code, Consolas" FontSize="11" Margin="8,6" />
                                                </Expander>

                                                <!-- Message Content -->
                                                <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True"
                                                         TextWrapping="Wrap" BorderThickness="0"
                                                         Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                                         FontSize="13" SelectionBrush="{StaticResource PrimaryBrush}" />

                                                <!-- Message Footer (Tokens, time, etc.) -->
                                                <TextBlock Text="{Binding Footer}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- User message styling -->
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource UserBubbleBrush}" />
                                                <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource UserBubbleBorderBrush}" />
                                                <Setter TargetName="Bubble" Property="Margin" Value="70,5,0,5" />
                                                <Setter TargetName="RoleIcon" Property="Data" Value="{StaticResource IconUser}" />
                                                <Setter TargetName="RoleIcon" Property="Fill" Value="{StaticResource InfoBrush}" />
                                            </DataTrigger>
                                            <!-- Tool call result styling -->
                                            <DataTrigger Binding="{Binding Role}" Value="Tool">
                                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource ToolBubbleBrush}" />
                                                <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource ToolBubbleBorderBrush}" />
                                                <Setter TargetName="RoleIcon" Property="Data" Value="{StaticResource IconWrench}" />
                                                <Setter TargetName="RoleIcon" Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <!-- Error message styling -->
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="Bubble" Property="Background" Value="{StaticResource DangerBackgroundBrush}" />
                                                <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                                                <Setter TargetName="RoleIcon" Property="Data" Value="{StaticResource IconAlert}" />
                                                <Setter TargetName="RoleIcon" Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Input Box and Action Bar -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="64" MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     PreviewKeyDown="OnInputKeyDown"
                                     ToolTip="Enter — отправить, Shift+Enter — новая строка"
                                     Padding="8,6" Background="{StaticResource InputBackgroundBrush}"
                                     BorderBrush="{StaticResource InputBorderBrush}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource PrimaryButton}" Content="Отправить" Command="{Binding SendCommand}"
                                        Margin="0,0,0,6" MinWidth="95" Height="34" />
                                <Button Style="{StaticResource DangerButton}" Content="Стоп" Command="{Binding StopCommand}"
                                        Margin="0,0,0,6" MinWidth="95" Height="30" />
                                <Button Content="Очистить" Command="{Binding ClearCommand}" Margin="0" MinWidth="95" Height="30" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sidebar: Session & Generation Parameters -->
                    <Border Grid.Column="1" Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14" Margin="14,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="{StaticResource IconSettings}" Fill="{StaticResource PrimaryBrush}"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Параметры сессии" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,10" />

                                <TextBlock Text="Фильтр по аккаунту" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ModelFilters}" SelectedItem="{Binding ModelFilterAccount}"
                                          ToolTip="«все аккаунты» — модели активных аккаунтов каждого провайдера" />

                                <TextBlock Text="Модель" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Системный промпт" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="84" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                                <TextBlock Text="Reasoning effort" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ReasoningEfforts}" SelectedItem="{Binding ReasoningEffort}"
                                          ToolTip="Пусто — по умолчанию клиента. Поддерживается Codex и Antigravity" />

                                <TextBlock Text="Стоп-последовательность" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StopSequence, UpdateSourceTrigger=PropertyChanged}" />

                                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
                                    <StackPanel>
                                        <CheckBox Content="Потоковый ответ (stream)" IsChecked="{Binding Stream}" Margin="0,0,0,8" />
                                        <CheckBox Content="JSON-режим (response_format)" IsChecked="{Binding JsonMode}" Margin="0,0,0,8" />
                                        <CheckBox Content="Демо-функция get_current_time" IsChecked="{Binding UseDemoTool}" Margin="0"
                                                  ToolTip="Проверка tool calling: модель вызывает функцию, приложение выполняет её и продолжает диалог" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                               Text="Ответ формируют штатные CLI провайдеров в режиме только для чтения в изолированном рабочем каталоге. Function calling эмулируется инструкциями в промпте." />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: АККАУНТЫ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUsers}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Аккаунты" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>
                    
                    <DockPanel>
                        <!-- Accounts Toolbar -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ActivateCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Сделать активным" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CheckAccountCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Проверить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Проверить все" Command="{Binding CheckAllCommand}" />
                                <Button Command="{Binding LoginCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconKey}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Войти (клиент)" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding EditCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconEdit}" Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Изменить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Удалить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <!-- Accounts DataGrid -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column"
                                      MouseDoubleClick="OnAccountDoubleClick" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Провайдер" Binding="{Binding Provider}" />
                                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                                    <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Header="Состояние" Binding="{Binding Availability}" />
                                    <DataGridTextColumn Header="Учётная запись" Binding="{Binding Identity.Email}" />
                                    <DataGridTextColumn Header="Тариф" Binding="{Binding Identity.Plan}" />
                                    <DataGridTextColumn Header="Вход" Binding="{Binding AuthMode}" />
                                    <DataGridTextColumn Header="Каталог / ключ" Binding="{Binding ConfigDirectory}" />
                                    <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>

                    <!-- Account Editor -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="14,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Editor}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="{StaticResource IconEdit}" Fill="{StaticResource PrimaryBrush}"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Профиль аккаунта" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,0,0,10" />

                                <TextBlock Text="Id" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Провайдер" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DataContext.ProviderKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Provider}" />

                                <TextBlock Text="Способ входа" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DataContext.AuthModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding AuthMode}"
                                          ToolTip="NativeLogin — штатный вход клиента; ApiKeyFromEnvironment — ключ из переменной окружения" />

                                <TextBlock Text="Каталог конфигурации (CODEX_HOME / CLAUDE_CONFIG_DIR)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding ConfigDirectory, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Переменная окружения с API-ключом" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ApiKeyVariable, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Имя переменной, а не сам ключ. Значение копируется в переменную клиента (CODEX_API_KEY, GEMINI_API_KEY, …)" />

                                <TextBlock Text="Исполняемый файл (пусто — из PATH)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Рабочий каталог" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Модель по умолчанию" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DefaultModel, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Доп. аргументы CLI (пробел в значении — в кавычках)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Переменные окружения — по одной строке ИМЯ=значение, без секретов" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" VerticalScrollBarVisibility="Auto" />

                                <CheckBox Content="Включён" IsChecked="{Binding Enabled}" Margin="0,12,0,12" />

                                <WrapPanel Margin="0,0,0,10">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Добавить"
                                            Command="{Binding DataContext.AddAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Content="Сохранить"
                                            Command="{Binding DataContext.UpdateAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </WrapPanel>

                                <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                        Codex и Claude: несколько аккаунтов одновременно — у каждого свой каталог конфигурации; вход выполняет штатный клиент.
                                        Antigravity: один Google-вход на машину. Режим ApiKeyFromEnvironment — у каждого свой GEMINI_API_KEY.
                                        Cursor и Grok: один вход на машину.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: КВОТЫ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGauge}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Квоты" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <DockPanel Margin="16">
                    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,14">
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshQuotasCommand}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Обновить квоты" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <CheckBox Content="Автообновление раз в минуту" IsChecked="{Binding AutoRefreshQuotas}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </WrapPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Quotas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:QuotaCardViewModel}">
                                    <Border Width="400" Margin="0,0,14,14" Padding="14" CornerRadius="10"
                                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            Background="{StaticResource CardBackgroundBrush}">
                                        <StackPanel>
                                            <!-- Card Header -->
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </DockPanel>

                                            <!-- Status / Plan / Email -->
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />

                                            <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,10,0,8" />

                                            <!-- Buckets -->
                                            <ItemsControl ItemsSource="{Binding Buckets}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:QuotaBucketViewModel}">
                                                        <StackPanel Margin="0,5">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Path Data="{StaticResource IconClock}" Fill="{StaticResource PrimaryBrush}"
                                                                          Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ResetText}" Foreground="{StaticResource PrimaryBrush}"
                                                                               FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <ProgressBar Value="{Binding Used, Mode=OneWay}" Maximum="100" Height="7" Margin="0,5"
                                                                         Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}" />

                                                            <TextBlock Text="{Binding ValueText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Warning Message if any -->
                                            <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0"
                                                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource WarningBrush}" FontSize="11" />
                                            </Border>

                                            <!-- Card Details -->
                                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 4: ПРОВАЙДЕРЫ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconServer}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Провайдеры" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Border Margin="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Providers}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Провайдер" Binding="{Binding DisplayName}" />
                            <DataGridCheckBoxColumn Header="Установлен" Binding="{Binding Installed, Mode=OneWay}" />
                            <DataGridTextColumn Header="Путь" Binding="{Binding ResolvedPath}" />
                            <DataGridCheckBoxColumn Header="Квоты" Binding="{Binding Capabilities.SupportsQuota, Mode=OneWay}" />
                            <DataGridTextColumn Header="Источник квот" Binding="{Binding Capabilities.QuotaSource}" />
                            <DataGridTextColumn Header="Мультиаккаунт" Binding="{Binding Capabilities.MultiAccount}" />
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Capabilities.MultiAccountNotes}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- TAB 5: ЖУРНАЛ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTerminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Журнал" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Border Margin="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="6">
                    <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent" />
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
